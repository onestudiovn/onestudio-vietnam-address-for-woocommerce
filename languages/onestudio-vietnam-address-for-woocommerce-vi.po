#: vn-address-woocommerce.php
msgid "OneStudio Vietnam Address for WooCommerce"
msgstr "OneStudio Vietnam Address for WooCommerce"

#. Plugin URI of the plugin
#: vn-address-woocommerce.php
msgid "https://onestudio.vn/plugins/vietnam-address-woocommerce"
msgstr "https://onestudio.vn/plugins/vietnam-address-woocommerce"

#. Description of the plugin
#: vn-address-woocommerce.php
msgid ""
"Integrates the latest Vietnamese administrative addresses into WooCommerce. "
"Supports converting old addresses to new addresses."
msgstr ""
"Tích hợp địa chỉ hành chính Việt Nam mới nhất vào WooCommerce, hỗ trợ chuyển "
"đổi địa chỉ cũ sang địa chỉ mới."

#. Author of the plugin
#: vn-address-woocommerce.php
msgid "OneStudio"
msgstr "OneStudio"

#. Author URI of the plugin
#: vn-address-woocommerce.php
msgid "https://onestudio.vn"
msgstr "https://onestudio.vn"

